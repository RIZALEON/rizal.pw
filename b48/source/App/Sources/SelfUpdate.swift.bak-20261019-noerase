let kSelfUpdateDefaultManifestURL = "https://raw.githubusercontent.com/rizalward/RZL-EGG/main/dragon-skull/ios-web/appcast.json"

struct SelfUpdateError: Error, CustomStringConvertible {
    let description: String
    init(_ s: String) { description = s }
}

