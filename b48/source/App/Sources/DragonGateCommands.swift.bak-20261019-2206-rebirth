enum DGCmdOrigin: String { case typedChat = "typed-chat", model, recall, web, rvm, plugin, update, api }

final class DGCommands: @unchecked Sendable {
    struct Reply { var text: String; var code: String? = nil; var changed = false }
    static let shared = DGCommands()
    static let confirmSeconds: TimeInterval = 60
    static let alphabet = Array("ABCDEFGHJKMNPQRSTUVWXYZ23456789")
    static let updateHost = "raw.githubusercontent.com"

    var coreProvider: () -> DragonGateCore? = { DGGate.shared.core as? DragonGateCore }
    var now: () -> Date = Date.init
    /// Transcript mirror (DRAGON SKULL: MemoryStore.shared.event("gate", kind, text)). Never receives a confirm code.
    var log: ((_ kind: String, _ text: String) -> Void)? = nil
    private var pending: (action: String, code: String, expires: Date, tries: Int)?
    private let lock = NSLock()

    /// True for anything the command layer owns (so it must never reach the model or chat memory).
    static func isCommand(_ text: String) -> Bool {
        let t = text.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
        return isTestCommand(t) || HostBridgeCmd.isCommand(text) || baseCommand(text) != nil || t == ":commands" || t == "/commands" || t == "/gate" || t.hasPrefix("/gate ") || t.hasPrefix("/gate\t")
    }
    /// SCOUT rvm-chatcmd 2026-10-19: `/rvm …` or a message starting with the word `rvm`. Run ONLY in the page by dg-cmd.js (RVM console);
    /// a copy reaching the server over HTTP is answered locally: never sent to the model, never recorded as chat memory.
    static func isRvmCommand(_ text: String) -> Bool {
        let t = text.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
        return t == "rvm" || t == "/rvm" || t.hasPrefix("rvm ") || t.hasPrefix("/rvm ") || t.hasPrefix("rvm\t") || t.hasPrefix("/rvm\t")
    }
    /// TEST 2026-10-19: `TEST`, `/test`, `test` (any case), optionally followed by quick | status | stop. Whole message only.
    static func isTestCommand(_ text: String) -> Bool {
        let w = text.trimmingCharacters(in: .whitespacesAndNewlines).lowercased().split(whereSeparator: { $0 == " " || $0 == "\t" }).map(String.init)
        guard let f = w.first, f == "test" || f == "/test" else { return false }
        return w.count == 1 || (w.count == 2 && ["quick", "status", "stop"].contains(w[1]))
    }
    /// ЯOS base commands 2026-10-19 cmds. Slash form takes any arguments; slashless only the bare word or a known subcommand
    /// (so ordinary chat like "fix this code" still goes to the model). reverse-engineering is an alias of REOPS.
    static let baseWords: Set<String> = ["chalkboard", "chalk", "handoff", "reops", "reverse-engineering", "fix", "manual"]
    static func baseCommand(_ text: String) -> (word: String, args: [String], raw: String)? {
        let t = text.trimmingCharacters(in: .whitespacesAndNewlines)
        let parts = t.split(whereSeparator: { $0 == " " || $0 == "\t" || $0 == "\n" }).map(String.init)
        guard let f0 = parts.first else { return nil }
        let slash = f0.hasPrefix("/"), f = (slash ? String(f0.dropFirst()) : f0).lowercased()
        guard baseWords.contains(f) else { return nil }
        let w = f == "reverse-engineering" ? "reops" : f, args = Array(parts.dropFirst()), a1 = args.first?.lowercased() ?? ""
        let raw = String(t.dropFirst(f0.count)).trimmingCharacters(in: .whitespacesAndNewlines)
        if !slash && !args.isEmpty {
            let ok: Bool
            switch w {
            case "chalkboard": ok = (a1 == "show" && args.count == 1) || (a1 == "post" && args.count >= 2)
            case "chalk": ok = (a1 == "word" && args.count == 2) || (a1 == "results" && args.count == 1)
            case "handoff": ok = a1 == "note" && args.count >= 2
            case "reops": ok = a1 == "status" && args.count == 1
            case "fix": ok = args.count == 1 && ["detect", "verify", "mac", "iphone", "ipad"].contains(a1)
            default: ok = false
            }
            if !ok { return nil }
        }
        return (w, args, raw)
    }
    /// Platform runner for TEST (Mac: python ЯZL v0.2 runner in main.swift). nil = iOS light version below. Same function names on both.
    var testHook: ((_ sub: String) -> String)? = nil
    func runTest(_ sub: String) -> String {
        if let h = testHook { return h(sub) }
        return DSDeviceTest.shared.handle(sub)   // iOS 2026-10-19 cmds: on-device ЯZL v0.2.1 suite (coding generation-only, needs Mac sandbox)
    }
    /// ЯBAT 2026-10-19: `rscribe …` at the start of a message (with or without the slash) is run in the page by dg-cmd.js (RVM console),
    /// like /rvm; a copy reaching the server over HTTP is answered locally: never sent to the model, never recorded as chat memory.
    static func isRscribeCommand(_ text: String) -> Bool {
        let t = text.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
        return t == "rscribe" || t == "/rscribe" || t.hasPrefix("rscribe ") || t.hasPrefix("/rscribe ") || t.hasPrefix("rscribe\t") || t.hasPrefix("/rscribe\t")
    }
    static let rscribeHTTPReply = "rscribe commands run only when you type them in the DRAGON SKULL chat box. Nothing was sent to the model."
    static let rvmHTTPReply = "RVM commands run only when you type them in the DRAGON SKULL chat box (rvm <command>). Nothing was sent to the model."
    /// Lines that look like a gate command, anywhere (model output, recall, web, injected context).
    static let gateLineRx = try! NSRegularExpression(pattern: #"(?im)^[ \t>*\-`"']*(?:/gate\b|[:/]commands\b)[^\n]*"#)
    static func containsGate(_ s: String) -> Bool { gateLineRx.firstMatch(in: s, range: NSRange(s.startIndex..., in: s)) != nil }
    static func stripGate(_ s: String) -> (String, Int) {
        let n = gateLineRx.numberOfMatches(in: s, range: NSRange(s.startIndex..., in: s))
        guard n > 0 else { return (s, 0) }
        return (gateLineRx.stringByReplacingMatches(in: s, range: NSRange(s.startIndex..., in: s), withTemplate: "[gate command removed]"), n)
    }

    /// Strict host check: lowercase DNS name, ≥2 labels, no scheme/port/path/wildcard/IP/loopback/guarded names.
    static func validHost(_ raw: String) -> String? {
        let h = raw.trimmingCharacters(in: .whitespaces).lowercased()
        guard (4...253).contains(h.count), !h.hasSuffix("."), !h.hasPrefix("."), h.allSatisfy({ ("a"..."z").contains($0) || ("0"..."9").contains($0) || $0 == "." || $0 == "-" }) else { return nil }
        let labels = h.split(separator: ".", omittingEmptySubsequences: false)
        guard labels.count >= 2, labels.allSatisfy({ (1...63).contains($0.count) && !$0.hasPrefix("-") && !$0.hasSuffix("-") }) else { return nil }
        guard let tld = labels.last, tld.contains(where: { $0.isLetter }) else { return nil }        // no bare IPv4
        if h == "localhost" || h.hasSuffix(".localhost") || DGGuard.hit(h) { return nil }
        return h
    }

    private func code() -> String { var g = SystemRandomNumberGenerator(); return String((0..<4).map { _ in Self.alphabet.randomElement(using: &g)! }) }
    private func note(_ kind: String, _ text: String, rule: String, ok: Bool) {
        coreProvider()?.recordCommand(text, rule: rule, allowed: ok)
        log?(kind, text)
    }

    @discardableResult func run(_ input: String, origin: DGCmdOrigin) -> Reply {
        let text = input.trimmingCharacters(in: .whitespacesAndNewlines)
        let low = text.lowercased().split(whereSeparator: { $0 == " " || $0 == "\t" }).map(String.init)
        let shown = low.count >= 2 && low[1] == "confirm" ? "/gate confirm ****" : (low.count >= 2 && (low[0] == "chalk" || low[0] == "/chalk") && low[1] == "word") ? "chalk word ****" : String(text.prefix(120))
        guard origin == .typedChat else {
            note("gate-cmd-refused", "refused \(shown) from \(origin.rawValue): gate commands are honored only when typed in the chat box", rule: "cmd-untrusted-origin", ok: false)
            return Reply(text: "DRAGONGATE: refused. Commands work only when you type them in the chat box yourself.")
        }
        if Self.isTestCommand(text) { log?("test-cmd", shown); return Reply(text: runTest(low.count > 1 ? low[1] : "start")) }
        if HostBridgeCmd.isCommand(text) { log?("host-cmd", shown); return Reply(text: HostBridge.shared.handle(text)) }
        if let b = Self.baseCommand(text) { log?("base-cmd", shown); return Reply(text: DSBase.shared.run(b.word, b.args, b.raw)) }
        if low.first == ":commands" || low.first == "/commands" { log?("gate-cmd", ":commands"); return Reply(text: DSCommandRegistry.listText()) }
        guard low.first == "/gate", let core = coreProvider() else { return Reply(text: "DRAGONGATE: the gate core is not running, so nothing can leave the device. Try again after restart.") }
        let a = Array(low.dropFirst())
        lock.lock(); defer { lock.unlock() }
        func ok(_ t: String, changed: Bool = false, _ rule: String = "cmd") -> Reply { note("gate-cmd", "\(shown) → ok", rule: rule, ok: true); return Reply(text: t, changed: changed) }
        func no(_ t: String, _ rule: String = "cmd-bad") -> Reply { note("gate-cmd", "\(shown) → refused (\(rule))", rule: rule, ok: false); return Reply(text: t) }
        func ask(_ action: String, _ what: String) -> Reply {
            let c = code(); pending = (action, c, now().addingTimeInterval(Self.confirmSeconds), 0)
            note("gate-cmd", "\(shown) → confirm requested (60 s)", rule: "cmd-confirm-asked", ok: true)
            return Reply(text: "To \(what), type /gate confirm followed by the 4-character code shown in the pop-up, within 60 seconds.", code: c)
        }
        switch a {
        case [], ["help"]: return ok(DSCommandRegistry.gateHelp())
        case ["status"]: return ok(status(core))
        case ["online", "on"]:
            if (core.state()["kill"] as? Bool) == true { return no("Kill is on, so online can't be turned on. Release it first with /gate kill off.", "cmd-kill-on") }
            if (core.state()["online"] as? Bool) == true { return ok("Online is already on.\n" + allowNote(core)) }
            var r = ask("online-on", "turn online on"); r.text += "\n" + allowNote(core); return r
        case ["online", "off"]:
            if pending?.action == "online-on" { pending = nil }
            core.setFlag("online", false); return ok("Online is off. Nothing leaves the device; loopback still works.", changed: true)
        case ["kill", "on"]:
            pending = nil                                   // fail-safe: cancels any pending loosening
            core.setFlag("kill", true); DGGate.shared.mirror?("gate-kill", "DRAGONGATE kill switch closed every outbound path (typed command)")
            return ok("Kill is on. Everything off-device is blocked; loopback still works.", changed: true, "kill-switch")
        case ["kill", "off"]:
            if (core.state()["kill"] as? Bool) != true { return ok("Kill is already off.") }
            return ask("kill-off", "release the kill switch")
        case let x where x.count == 2 && x[0] == "confirm":
            guard let p = pending else { return no("Nothing is waiting for a confirm.", "cmd-no-pending") }
            if now() > p.expires { pending = nil; return no("That confirm expired. Start again.", "cmd-expired") }
            guard x[1].uppercased() == p.code else {
                if p.tries + 1 >= 3 { pending = nil; return no("Wrong code three times; cancelled. Start again.", "cmd-bad-code") }
                pending = (p.action, p.code, p.expires, p.tries + 1); return no("Wrong code.", "cmd-bad-code")
            }
            pending = nil
            if p.action == "online-on" { core.setFlag("online", true); return ok("Online is on.\n" + allowNote(core), changed: true, "cmd-online-on") }
            core.setFlag("kill", false); return ok("Kill is off. Online is \((core.state()["online"] as? Bool) == true ? "on" : "off").", changed: true, "cmd-kill-off")
        case ["allow", "list"]: return ok(allowListText(core))
        case let x where x.count == 2 && (x[0] == "allow" || x[0] == "deny"):
            guard let h = Self.validHost(x[1]) else { return no("Not a valid host. Use one exact host name like example.com, with no https://, port, path or wildcard.", "cmd-bad-host") }
            var l = core.allowList()
            if x[0] == "allow" {
                if l.contains(h) { return ok("\(h) is already allowed.") }
                l.append(h); core.setAllowList(l)
                return ok("Allowed \(h)." + ((core.state()["online"] as? Bool) == true ? "" : " Online is off, so nothing goes out until you turn it on."), changed: true)
            }
            guard l.contains(h) else { return ok("\(h) wasn't on the allowlist.") }
            l.removeAll { $0 == h }; core.setAllowList(l); return ok("Removed \(h).", changed: true)
        case ["plugins", "owner"]: core.setFlag("approval", "owner-approved"); return ok("Plugins: owner-approved only.", changed: true)
        case ["plugins", "signed"]: core.setFlag("approval", "signed"); return ok("Plugins: Owner approval of the plugin's exact hash is required; a signature never replaces it (on its own it neither grants nor blocks).", changed: true)
        default: return no("Unknown gate command. Type /gate help.", "cmd-unknown")
        }
    }

    private func allowNote(_ core: DragonGateCore) -> String {
        let l = core.allowList()
        var t = l.isEmpty ? "The allowlist is empty, so nothing off-device is allowed even with online on. Add hosts with /gate allow <host>." : "Allowed hosts: \(l.joined(separator: ", "))."
        if !l.contains(Self.updateHost) { t += " Self-update stays paused until \(Self.updateHost) is allowed." }
        return t
    }
    private func allowListText(_ core: DragonGateCore) -> String {
        let l = core.allowList(); return l.isEmpty ? "The allowlist is empty." : "Allowlist (\(l.count)):\n" + l.enumerated().map { "\($0.offset + 1). \($0.element)" }.joined(separator: "\n")
    }
    private func status(_ core: DragonGateCore) -> String {
        let s = core.state(), f = DateFormatter(); f.dateFormat = "yyyy-MM-dd"; f.timeZone = .current
        let today = f.string(from: now()), rep = core.report(day: today)
        let deny = ((rep["decisions"] as? [String: Int])?["deny"]) ?? 0
        var byRule: [String: Int] = [:]; for d in (rep["denials"] as? [[String: Any]]) ?? [] { byRule[(d["rule"] as? String) ?? "?", default: 0] += 1 }
        let rules = byRule.sorted { $0.value > $1.value }.map { "\($0.key) \($0.value)" }.joined(separator: ", ")
        return """
        DRAGONGATE status
        • mode: \((s["gate"] as? Bool) == true ? "monitor" : "pass-through")
        • online: \((s["online"] as? Bool) == true ? "on" : "off")
        • kill: \((s["kill"] as? Bool) == true ? "on" : "off")
        • plugins: \((s["approval"] as? String) == "signed" ? "signed" : "owner")
        • allowlist: \(core.allowList().isEmpty ? "(empty)" : core.allowList().joined(separator: ", "))
        • blocked today: \(deny)\(rules.isEmpty ? "" : " (recent: \(rules))")
        • pending confirm: \(pending.map { $0.action } ?? "none")
        """
    }
}

// ==== BASE COMMANDS 2026-10-19 (cmds) · CHALKBOARD · CHALK · HANDOFF · REOPS · FIX · MANUAL ====
// Source: ЯKLASSROOM/BASE-MIND/SEED/BASE-COMMANDS.json + UNIFIED-CLASSROOM-MANUAL.md. Shared, identical on Mac and iOS. Local/offline only:
// data lives in <Application Support>/dragonskull-commands/, written append-only (or as new files). Nothing here ever deletes or
// overwrites a file (never-remove transcript law, REQ-19). FIX never erases/restores anything (no idevicerestore from the app).
final class DSBase: @unchecked Sendable {
    static let shared = DSBase()
    /// Platform hook (Mac main.swift: llama-server pid; iOS App.swift: in-app engine ready).
    var engineStatus: (() -> String)? = nil
    #if os(macOS)
    let platform = "Mac"
    #else
    let platform = "iPhone"
    #endif
    private let lock = NSLock()
    var root: URL { RlabData.appSupport.appendingPathComponent("dragonskull-commands", isDirectory: true) }
    private func f(_ n: String) -> URL { root.appendingPathComponent(n) }
    private func ts(_ fmt: String = "yyyy-MM-dd HH:mm:ss ZZZZZ") -> String { let d = DateFormatter(); d.dateFormat = fmt; d.timeZone = .current; return d.string(from: Date()) }
    private var version: String { let i = Bundle.main.infoDictionary ?? [:]; return "\(i["CFBundleShortVersionString"] as? String ?? "?") (\(i["CFBundleVersion"] as? String ?? "?"))" }
    @discardableResult private func append(_ u: URL, _ s: String, header: String = "") -> Bool {
        let fm = FileManager.default
        try? fm.createDirectory(at: u.deletingLastPathComponent(), withIntermediateDirectories: true)
        if !fm.fileExists(atPath: u.path) { guard fm.createFile(atPath: u.path, contents: Data(header.utf8)) else { return false } }
        guard let h = try? FileHandle(forWritingTo: u) else { return false }
        defer { try? h.close() }
        h.seekToEndOfFile(); h.write(Data(s.utf8)); return true
    }
    private func read(_ u: URL) -> String { (try? String(contentsOf: u, encoding: .utf8)) ?? "" }
    private func entries(_ u: URL, prefix: String) -> [String] { read(u).split(separator: "\n").map(String.init).filter { $0.hasPrefix(prefix) } }

    func run(_ w: String, _ args: [String], _ raw: String) -> String {
        lock.lock(); defer { lock.unlock() }
        let a1 = args.first?.lowercased() ?? ""
        switch w {
        case "chalkboard": return a1 == "post" || a1 == "write" ? chalkPost(String(raw.dropFirst(a1.count)).trimmingCharacters(in: .whitespaces)) : chalkShow()
        case "chalk":
            if a1 == "word", args.count >= 2 { return chalkSecret(args[1]) }
            if a1 == "results" { return chalkResults() }
            return "CHALK (REQ-17): `chalk word <WORD>` records a secret word silently (it is never shown in chat); `chalk results` shows the results file and PASS counts.\n" + chalkResults()
        case "handoff": return handoff(a1 == "note" ? String(raw.dropFirst(4)).trimmingCharacters(in: .whitespaces) : raw)
        case "reops": return reops()
        case "fix": return fix(a1.isEmpty ? "detect" : a1)
        default: return manual()
        }
    }
    // CHALKBOARD (REQ-16): local board, append-only. The classroom autoclean is NOT applied on device (never-remove law); the latest entry is "Latest chalk".
    private func chalkShow() -> String {
        let e = entries(f("CHALKBOARD.md"), prefix: "- ")
        guard !e.isEmpty else { return "CHALKBOARD: board empty (local board \(f("CHALKBOARD.md").path)). Post with: chalkboard post <message>" }
        return "CHALKBOARD (\(e.count) entries, append-only, never removed) · Latest chalk:\n\(e.last!)\n\nRecent:\n" + e.suffix(15).joined(separator: "\n")
    }
    private func chalkPost(_ msg: String) -> String {
        guard !msg.isEmpty else { return "CHALKBOARD: nothing to post. Use: chalkboard post <message>" }
        let line = "- \(ts()) · DRAGON SKULL \(platform) · message=\(msg.replacingOccurrences(of: "\n", with: " "))\n"
        guard append(f("CHALKBOARD.md"), line, header: "# DRAGON SKULL CHALKBOARD (local, append-only · REQ-16 · never removed)\n\n") else { return "CHALKBOARD: FAIL, could not write the local board." }
        let seen = entries(f("CHALKBOARD.md"), prefix: "- ").last ?? ""
        return "CHALKBOARD: PASS · DRAGON SKULL \(platform) sees message=\(msg) (entry \(entries(f("CHALKBOARD.md"), prefix: "- ").count)).\n" + (seen.contains(msg) ? "" : "warning: readback mismatch\n") + "Board: \(f("CHALKBOARD.md").path)"
    }
    // CHALK (REQ-17): secret word stored silently; the chat reply never contains it.
    private func chalkSecret(_ word: String) -> String {
        let rec = "{\"at\":\"\(ts())\",\"bot\":\"DRAGON SKULL \(platform)\",\"word\":\"\(word.replacingOccurrences(of: "\\", with: "\\\\").replacingOccurrences(of: "\"", with: "\\\""))\"}\n"
        guard append(f("CHALK-SECRETS.jsonl"), rec) else { return "CHALK: FAIL, could not record the word." }
        let n = entries(f("CHALK-SECRETS.jsonl"), prefix: "{").count
        append(f("CHALK-RESULTS.md"), "- \(ts()) · DRAGON SKULL \(platform) · word received · PASS (secret #\(n) in CHALK-SECRETS.jsonl)\n", header: "# CHALK RESULTS (REQ-17 · for the other party · words are inside CHALK-SECRETS.jsonl, not here)\n\n")
        return "CHALK: secret word recorded silently. PASS 1/1 (DRAGON SKULL \(platform)).\nResults: \(f("CHALK-RESULTS.md").path)"
    }
    private func chalkResults() -> String {
        let r = entries(f("CHALK-RESULTS.md"), prefix: "- ")
        return r.isEmpty ? "CHALK results: none yet." : "CHALK results: PASS \(r.filter { $0.contains("PASS") }.count)/\(r.count) · \(f("CHALK-RESULTS.md").path)\n" + r.suffix(10).joined(separator: "\n")
    }
    // HANDOFF: new timestamped file every time (never overwrites).
    private func handoff(_ note: String) -> String {
        let dir = root.appendingPathComponent("HANDOFF", isDirectory: true)
        var u = dir.appendingPathComponent("HANDOFF-\(ts("yyyyMMdd-HHmmss"))-DRAGONSKULL-\(platform).md"); var k = 2
        while FileManager.default.fileExists(atPath: u.path) { u = dir.appendingPathComponent("HANDOFF-\(ts("yyyyMMdd-HHmmss"))-DRAGONSKULL-\(platform)-\(k).md"); k += 1 }
        let body = """
        # HANDOFF · DRAGON SKULL \(platform) · \(ts())
        - version: \(version)
        - commands known: \(DSCommandRegistry.all.count)
        - engine: \(engineStatus?() ?? "n/a")
        - chalkboard entries: \(entries(f("CHALKBOARD.md"), prefix: "- ").count) · chalk results: \(entries(f("CHALK-RESULTS.md"), prefix: "- ").count)
        - last TEST: \(DGCommands.shared.runTest("status").prefix(400))
        - self-check: \(selfCheck().1)
        ## Note (done / left off)
        \(note.isEmpty ? "(no note given; type: handoff note <text>)" : note)

        Law: transcripts and handoffs are never removed (REQ-19). Local file only; nothing pushed or published from the app.

        """
        guard append(u, body) else { return "HANDOFF: FAIL, could not write \(u.path)" }
        return "HANDOFF written: \(u.path)"
    }
    /// Local self-check used by REOPS and FIX. Returns (lines, summary).
    func selfCheck() -> ([String], String) {
        var L: [String] = [], pass = 0, n = 0
        func ck(_ name: String, _ ok: Bool, _ d: String) { n += 1; if ok { pass += 1 }; L.append("\(ok ? "PASS" : "FAIL") \(name): \(d)") }
        let fm = FileManager.default, res = Bundle.main.resourceURL ?? URL(fileURLWithPath: "/")
        ck("version", true, version)
        ck("commands", DSCommandRegistry.all.count >= 34, "\(DSCommandRegistry.all.count) in the shared registry")
        let core = DGGate.shared.core as? DragonGateCore, st = core?.state() ?? [:]
        ck("dragongate", core != nil, core == nil ? "core not running" : "online \((st["online"] as? Bool) == true ? "on" : "off") · kill \((st["kill"] as? Bool) == true ? "on" : "off")")
        ck("web bundle", fm.fileExists(atPath: res.appendingPathComponent("web/dg-cmd.js").path), res.appendingPathComponent("web").path)
        ck("model", fm.fileExists(atPath: res.appendingPathComponent("model/granite-4.0-h-1b-Q4_K_M.gguf").path), "granite-4.0-h-1b-Q4_K_M.gguf in the app bundle")
        ck("drive1", fm.fileExists(atPath: RlabData.url.path), RlabData.url.lastPathComponent)
        let w = append(f("SELFCHECK.log"), "- \(ts()) · self-check\n")
        ck("data dir", w, root.path + " (append-only)")
        if let e = engineStatus?() { ck("engine", !e.lowercased().contains("not"), e) }
        return (L, "\(pass)/\(n) PASS")
    }
    private func reops() -> String {
        let (l, s) = selfCheck()
        return """
        REOPS (REQ-REOPS) · evidence-bounded reverse engineering, offline.
        Maps artifact declarations, proposed names, refusals and explicit gates. It does not decompile binaries, reconstruct source, unpack archives, decide unknown bytes, or run any model/runner automatically (the runner TOOLS/reops-run-qwen3.sh is Mac-only and Decider-run).
        Self-check \(s):
        """ + "\n" + l.joined(separator: "\n")
    }
    private func fix(_ t: String) -> String {
        let (l, s) = selfCheck()
        let head: String
        switch t {
        case "iphone", "ipad": head = "FIX \(t): refused in the app. Erase/restore (deep-repair idevicerestore) never runs from DRAGON SKULL; on Neo it is ~/ЯLAB/RESTORE/fix.sh and needs the Decider's go. Safe no-wipe self-check instead:"
        case "mac": head = "FIX mac: harness self-check only (no erase, no bootload):"
        default: head = "FIX \(t): safe, no wipe. Self-check:"
        }
        return head + " \(s)\n" + l.joined(separator: "\n")
    }
    private func manual() -> String {
        let chat = DSCommandRegistry.all.filter { $0.scope == "chat" && !$0.gate }, gate = DSCommandRegistry.all.filter { $0.gate }, rvm = DSCommandRegistry.all.filter { $0.scope == "rvm" }
        func sec(_ t: String, _ l: [DSCommand]) -> String { "\n## \(t)\n" + l.map { "• \($0.usage) — \($0.summary)" }.joined(separator: "\n") }
        return "DRAGON SKULL COMMAND MANUAL rev 3 · \(version) · \(DSCommandRegistry.all.count) commands. Type them in the chat box, with or without the slash, any case; they are answered on the device and never sent to the model."
            + sec("Chat and ЯOS base commands", chat) + sec("DRAGONGATE (typed only)", gate) + sec("RVM terminal", rvm)
            + "\n## Laws\n• Transcripts, handoffs and chalk are never removed (REQ-19). • FIX never erases from the app. • Offline unless you type /gate online on. Full classroom manual: ЯKLASSROOM/UNIFIED-CLASSROOM-MANUAL.md (Neo)."
    }
