/// 1.0.4.33 · orange + attach. WK "dsAttach" {op:"pick"} -> action sheet: Photos (PHPicker) · Files or Folder (UIDocumentPicker, .item + .folder, multi).
/// Every pick is COPIED (add-only, never deletes, never uploads) into Documents/ЯLAB/RKLOWD/nodes/17e/attachments/<stamp>/,
/// then window.DS_ATTACHED([{name,kind,bytes,files,rel}]) is called in the page. {op:"save",name,b64} stores a web-picked file the same way.
@MainActor final class DSAttach: NSObject, WKScriptMessageHandler, UIDocumentPickerDelegate, PHPickerViewControllerDelegate {
    static let shared = DSAttach()
    private weak var webView: WKWebView?
    static func install(on w: WKWebView) {
        shared.webView = w
        w.configuration.userContentController.add(shared, name: "dsAttach")
    }
    private var root: URL {
        let docs = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
        return docs.appendingPathComponent("ЯLAB/RKLOWD/nodes/17e/attachments", isDirectory: true)
    }
    private func newBatch() -> URL {
        let f = DateFormatter(); f.dateFormat = "yyyyMMdd-HHmmss"; f.locale = Locale(identifier: "en_US_POSIX")
        var d = root.appendingPathComponent(f.string(from: Date()), isDirectory: true); var n = 1
        while FileManager.default.fileExists(atPath: d.path) { n += 1; d = root.appendingPathComponent(f.string(from: Date()) + "-\(n)", isDirectory: true) }
        try? FileManager.default.createDirectory(at: d, withIntermediateDirectories: true)
        return d
    }
    private func uniq(_ dir: URL, _ name: String) -> URL {
        let safe = name.replacingOccurrences(of: "/", with: "_").replacingOccurrences(of: "..", with: "_")
        var u = dir.appendingPathComponent(safe.isEmpty ? "file" : safe); var i = 1
        while FileManager.default.fileExists(atPath: u.path) { i += 1; u = dir.appendingPathComponent("\(i)-" + safe) }
        return u
    }
    private func describe(_ u: URL) -> [String: Any] {
        var isDir: ObjCBool = false
        FileManager.default.fileExists(atPath: u.path, isDirectory: &isDir)
        var bytes = 0, files = 0
        if isDir.boolValue {
            if let e = FileManager.default.enumerator(at: u, includingPropertiesForKeys: [.fileSizeKey, .isRegularFileKey]) {
                for case let f as URL in e { let v = try? f.resourceValues(forKeys: [.fileSizeKey, .isRegularFileKey]); if v?.isRegularFile == true { files += 1; bytes += v?.fileSize ?? 0 } }
            }
        } else { files = 1; bytes = (try? u.resourceValues(forKeys: [.fileSizeKey]).fileSize) ?? 0 }
        let rel = u.path.replacingOccurrences(of: root.deletingLastPathComponent().deletingLastPathComponent().path + "/", with: "")
        return ["name": u.lastPathComponent, "kind": isDir.boolValue ? "folder" : "file", "bytes": bytes, "files": files, "rel": "ЯLAB/RKLOWD/nodes/" + rel]
    }
    private func deliver(_ items: [[String: Any]]) {
        guard !items.isEmpty, let d = try? JSONSerialization.data(withJSONObject: items), let j = String(data: d, encoding: .utf8) else { return }
        webView?.evaluateJavaScript("window.DS_ATTACHED && window.DS_ATTACHED(\(j))", completionHandler: nil)
    }
    private func top() -> UIViewController? {
        var t = webView?.window?.rootViewController; while let p = t?.presentedViewController { t = p }; return t
    }
    func userContentController(_ c: WKUserContentController, didReceive m: WKScriptMessage) {
        guard m.frameInfo.isMainFrame, let b = m.body as? [String: Any], let op = b["op"] as? String else { return }
        if op == "pick" { presentMenu() }
        else if op == "tfStatus" { tfStatus() }
        else if op == "openTF" { openTF(b["path"] as? String) }
        else if op == "save", let name = b["name"] as? String, let b64 = b["b64"] as? String, let data = Data(base64Encoded: b64), data.count <= 64 * 1024 * 1024 {
            let u = uniq(newBatch(), name); if (try? data.write(to: u)) != nil { deliver([describe(u)]) }
        }
    }
    // 1.0.4.35 · ThundR > TerraformЯ (read-only status + open). Never signs: signing stays in TerraformЯ.
    private static let tfScheme = "terraformr"
    private func tfStatus() {
        var out: [String: Any] = ["scheme": Self.tfScheme]
        if let u = URL(string: Self.tfScheme + "://") { out["canOpen"] = UIApplication.shared.canOpenURL(u) }
        let docs = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
        let req = docs.appendingPathComponent("ЯLAB/RKLOWD/nodes/17e/drop/typed-request.public.json")
        if let d = try? Data(contentsOf: req), let o = (try? JSONSerialization.jsonObject(with: d)) as? [String: Any] {
            var r: [String: Any] = [:]   // public, display-only fields
            for k in ["block", "op", "req_hash", "status", "state", "created_at", "ts", "ui_label", "device_id", "label", "id", "req_id", "index", "block_sha256"] { if let v = o[k], v is String || v is NSNumber { r[k] = v } }
            out["request"] = r
            if let m = (try? req.resourceValues(forKeys: [.contentModificationDateKey]))?.contentModificationDate { out["requestModified"] = ISO8601DateFormatter().string(from: m) }
        } else { out["request"] = NSNull() }
        guard let j = try? JSONSerialization.data(withJSONObject: out), let s = String(data: j, encoding: .utf8) else { return }
        webView?.evaluateJavaScript("window.DS_TF_STATUS && window.DS_TF_STATUS(\(s))", completionHandler: nil)
    }
    private func openTF(_ path: String? = nil) {
        // 1.0.4.36: only terraformr://open or terraformr://rsign/bind?req=<id> (shell commands `terraformr` / `terraformr bind`)
        let p = path ?? "open"
        guard p == "open" || p.range(of: "^rsign/bind\\?req=[A-Za-z0-9._-]{3,80}$", options: .regularExpression) != nil,
              let u = URL(string: Self.tfScheme + "://" + p) else {
            webView?.evaluateJavaScript("window.DS_TF_OPENED && window.DS_TF_OPENED(false)", completionHandler: nil); return }
        UIApplication.shared.open(u, options: [:]) { ok in
            self.webView?.evaluateJavaScript("window.DS_TF_OPENED && window.DS_TF_OPENED(\(ok ? "true" : "false"))", completionHandler: nil)
        }
    }
    private func presentMenu() {
        guard let t = top() else { return }
        let a = UIAlertController(title: nil, message: nil, preferredStyle: .actionSheet)
        a.addAction(UIAlertAction(title: "Photos", style: .default) { _ in self.presentPhotos() })
        a.addAction(UIAlertAction(title: "Files or Folder", style: .default) { _ in self.presentFiles() })
        a.addAction(UIAlertAction(title: "Cancel", style: .cancel))
        if let pop = a.popoverPresentationController, let v = webView { pop.sourceView = v; pop.sourceRect = CGRect(x: 20, y: v.bounds.maxY - 60, width: 1, height: 1) }
        t.present(a, animated: true)
    }
    private func presentPhotos() {
        var cfg = PHPickerConfiguration(); cfg.selectionLimit = 0
        let p = PHPickerViewController(configuration: cfg); p.delegate = self
        top()?.present(p, animated: true)
    }
    private func presentFiles() {
        let p = UIDocumentPickerViewController(forOpeningContentTypes: [.item, .folder], asCopy: false)
        p.allowsMultipleSelection = true; p.delegate = self
        top()?.present(p, animated: true)
    }
    func documentPicker(_ c: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
        let batch = newBatch(); var out: [[String: Any]] = []
        for u in urls {
            let ok = u.startAccessingSecurityScopedResource(); defer { if ok { u.stopAccessingSecurityScopedResource() } }
            let dest = uniq(batch, u.lastPathComponent)
            var err: NSError?
            NSFileCoordinator().coordinate(readingItemAt: u, options: [], error: &err) { r in
                if (try? FileManager.default.copyItem(at: r, to: dest)) != nil { out.append(describe(dest)) }
            }
        }
        deliver(out)
    }
    nonisolated func picker(_ picker: PHPickerViewController, didFinishPicking results: [PHPickerResult]) {
        Task { @MainActor in
            picker.dismiss(animated: true)
            guard !results.isEmpty else { return }
            let batch = self.newBatch()
            for r in results {
                let pr = r.itemProvider
                guard let type = pr.registeredTypeIdentifiers.first(where: { UTType($0)?.conforms(to: .image) == true || UTType($0)?.conforms(to: .movie) == true }) ?? pr.registeredTypeIdentifiers.first else { continue }
                let base = pr.suggestedName ?? "photo"
                pr.loadFileRepresentation(forTypeIdentifier: type) { url, _ in
                    guard let url else { return }
                    let ext = url.pathExtension.isEmpty ? (UTType(type)?.preferredFilenameExtension ?? "bin") : url.pathExtension
                    let tmp = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString + "." + ext)
                    guard (try? FileManager.default.copyItem(at: url, to: tmp)) != nil else { return }   // provider file vanishes after return
                    Task { @MainActor in
                        let dest = self.uniq(batch, base + "." + ext)
                        if (try? FileManager.default.moveItem(at: tmp, to: dest)) != nil { self.deliver([self.describe(dest)]) }
                    }
                }
            }
        }
    }
