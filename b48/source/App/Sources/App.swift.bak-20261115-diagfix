        }
        .onChange(of: st.phase.readyFlag) { ready in
            if ready, !lock.skip, !lock.unlocked { lock.authenticate() }
        }
    }
    func status(_ s: String) -> some View {
        VStack(spacing: 12) { ProgressView().tint(.white); Text(s).foregroundColor(.white) }
    }
}

