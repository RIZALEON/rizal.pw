let kModelSHA256 = "fd3b85f09520df9d898e2bbcf5da22fc518dbf9d662bb52e214d946c72aafacc"

@MainActor final class AppState: ObservableObject {
    enum Phase { case checking, loading, ready, refused(String)
        var readyFlag: Bool { if case .ready = self { return true }; return false }
    }
    @Published var phase: Phase = .checking
    var server: LocalServer?
    let selftest = ProcessInfo.processInfo.arguments.contains("--selftest")

    func log(_ s: String) {
        print("[DRAGON SKULL] \(s)"); fflush(stdout)
        let u = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0].appendingPathComponent("ds-log.txt")
        let line = Data("\(Date()) \(s)\n".utf8)
        if let h = try? FileHandle(forWritingTo: u) { h.seekToEndOfFile(); h.write(line); try? h.close() } else { try? line.write(to: u) }
    }

    func boot() {
        Task.detached(priority: .userInitiated) {
            let model = Self.resolveModel()
            var digest = "missing"
            if let model {
                digest = Self.sha256(model)
                await MainActor.run { self.log("model sha256 \(digest)") }
                guard digest == kModelSHA256 else {
                    await MainActor.run { self.log("REFUSING: fingerprint mismatch"); self.phase = .refused("Model fingerprint mismatch.\nExpected \(kModelSHA256)\nGot \(digest)") }; return }
            } else {
                await MainActor.run { self.log("Granite model not on device (download-on-device, SHA \(kModelSHA256)); starting web without the engine") }
            }
            await MainActor.run { self.phase = .loading }
            let web = Bundle.main.resourceURL!.appendingPathComponent("web")
            SelfUpdater.shared.log = { s in
                Task { @MainActor in self.log("selfupdate: \(s)") }
                let kind = s.contains("rolled back") ? "selfupdate-rollback" : s.contains("staged ") ? "web-bundle-staged" : s.hasPrefix("serving web") ? "web-bundle-serving" : s.contains("reset to built-in") ? "selfupdate-reset" : "selfupdate-log"
                MemoryStore.shared.event(kind == "selfupdate-log" ? "selfupdate" : "update", kind, s)   // DRAGON-SKULL-MIND: every update + rollback
            }
            MemoryStore.shared.log = { s in Task { @MainActor in self.log("memory: \(s)") } }
            // DRAGONGATE (all-in-one 2026-10-19): core + facade before any server / web view / self-update fetch.
            // Runtime data lives in Application Support/dragongate/ (never bundled). A missing switch.json = defaults:
            // gate:true (monitor), online:false, kill:false, approval owner-approved. Kill = drawbridge: off-device denied + logged, loopback still flows.
            let gateRoot = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0].appendingPathComponent("dragongate", isDirectory: true)
            DGGate.shared.app = "info.rizal.dragonskull"
            DGGate.shared.mirror = { kind, text in MemoryStore.shared.event("gate", kind, text) }
            DGGate.shared.core = DragonGateCore(root: gateRoot, app: "info.rizal.dragonskull")
            DGCommands.shared.log = { kind, text in MemoryStore.shared.event("gate", kind, text) }   // gate events only; never a confirm code
            DSBase.shared.engineStatus = { Engine.shared.ready ? "in-app engine ready on 127.0.0.1:\(LocalServer.port)" : "engine not ready" }   // 2026-10-19 cmds
            let info = Bundle.main.infoDictionary ?? [:]
            MemoryStore.shared.event("update", "app-launch", "DRAGON SKULL iOS \(info["CFBundleShortVersionString"] as? String ?? "?") (\(info["CFBundleVersion"] as? String ?? "?")) launched",
                                     extra: ["appVersion": info["CFBundleShortVersionString"] as? String ?? "?", "build": info["CFBundleVersion"] as? String ?? "?", "modelSha256": String(digest.prefix(16))])
            RlabData.ensure { s in MemoryStore.shared.event("rvm", "rlab-data", s) }   // drive1: <RVM engine store>/drives/drive1 (RVM-ENGINE-LAYOUT.md), created once, never overwritten; legacy rlab-data moved
            SelfUpdater.shared.prepareAtLaunch(builtIn: web)   // promote staged / roll back unconfirmed web overlay before serving
            let srv = LocalServer(webRoot: web)
            do { try srv.start() } catch { await MainActor.run { self.phase = .refused("Local server failed: \(error)") }; return }
            var ok = false
            if let model { ok = Engine.shared.load(path: model.path) }
            else { await MainActor.run { self.log("engine skipped: Granite weights are download-on-device, not bundled") } }
            MemoryStore.shared.seedDay0(webRoots: SelfUpdater.shared.webRoots() + [web])   // DAY 0 history, appended once by id
            MemoryStore.shared.reindex(webRoots: SelfUpdater.shared.webRoots() + [web])   // memidx 2026-10-19: test/command turns out of recall (append-only)
            let st = SelfUpdater.shared.status()
            MemoryStore.shared.event("engine", ok ? "engine-start" : "engine-error", ok ? "engine ready on 127.0.0.1:\(LocalServer.port) · web \(st["serving"] as? String ?? "?") (built-in \(st["builtIn"] as? String ?? "?"))" : "engine failed to load the model",
                                     extra: ["webServing": st["serving"] as? String ?? "?", "webBuiltIn": st["builtIn"] as? String ?? "?"])
            await MainActor.run {
                self.server = srv
                if ok { self.log("engine ready on 127.0.0.1:8319"); self.phase = .ready; if self.selftest { self.runSelfTest() } else { SelfUpdater.shared.checkIfDue(reason: "launch") }
                    // 2026-10-19 cmds: owner launch door (devicectl --rzl-test from the paired Neo, same as --selftest): start the on-device TEST.
                    if ProcessInfo.processInfo.arguments.contains("--rzl-test") { MemoryStore.shared.event("test", "test-launch-arg", "--rzl-test"); _ = DGCommands.shared.runTest("start") } }
                else if model != nil { self.phase = .refused("Engine failed to load the model.") } else { self.log("web ready; engine waiting for download-on-device Granite"); self.phase = .ready; SelfUpdater.shared.checkIfDue(reason: "launch") }
            }
        }
    }

    /// Bundle first, then Application Support/Documents (download-on-device). SHA-pinned by the caller. Never auto-loads an unverified nearest .gguf.
    nonisolated static func resolveModel() -> URL? {
        let name = "granite-4.0-h-1b-Q4_K_M"
        if let bundled = Bundle.main.url(forResource: name, withExtension: "gguf", subdirectory: "model") { return bundled }
        let fm = FileManager.default
        let file = "\(name).gguf"
        let dirs = [fm.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0],
                    fm.urls(for: .documentDirectory, in: .userDomainMask)[0]]
        for root in dirs {
            let u = root.appendingPathComponent("model", isDirectory: true).appendingPathComponent(file)
            if fm.fileExists(atPath: u.path) { return u }
        }
        return nil
    }

    nonisolated static func sha256(_ url: URL) -> String {
        guard let h = try? FileHandle(forReadingFrom: url) else { return "unreadable" }
        var hasher = SHA256()
        while let d = try? h.read(upToCount: 8 << 20), !d.isEmpty { hasher.update(data: d) }
        return hasher.finalize().map { String(format: "%02x", $0) }.joined()
    }

    func runSelfTest() {
        let qs = ["Who are you, and are you online?", "What is (2+4+6)/3? Give the number."]
        Task.detached {
            for q in qs {
                var r = URLRequest(url: URL(string: "http://127.0.0.1:8319/engine/v1/chat/completions")!)
                r.httpMethod = "POST"; r.setValue("application/json", forHTTPHeaderField: "Content-Type"); r.timeoutInterval = 300
                r.httpBody = try? JSONSerialization.data(withJSONObject: ["messages": [["role": "user", "content": q]], "max_tokens": 128, "temperature": 0])
                let t0 = Date()
                var ans = "(no answer)"
                if let (d, _) = try? await URLSession.shared.data(for: r), let o = try? JSONSerialization.jsonObject(with: d) as? [String: Any],
                   let ch = o["choices"] as? [[String: Any]], let m = ch.first?["message"] as? [String: Any] { ans = (m["content"] as? String) ?? "" }
                let dt = String(format: "%.1f", Date().timeIntervalSince(t0))
                await MainActor.run { self.log("SELFTEST Q: \(q) | A (\(dt)s): \(ans.replacingOccurrences(of: "\n", with: " "))") }
            }
            await MainActor.run { self.log("SELFTEST DONE") }
        }
    }
}


/// Session Face ID / device-passcode gate for the RDRAGON UI. Never stores a secret. 20261110.
/// Covers the SwiftUI window. The web egg also ships rlock-screen.js, which no-ops if this handler is absent.
@MainActor final class AppFaceLock: NSObject, ObservableObject, WKScriptMessageHandler {
    static let shared = AppFaceLock()
    @Published var unlocked = false
    var skip = false
    private weak var webView: WKWebView?
    private var backgrounded = false

    static func install(on w: WKWebView) {
        shared.webView = w
        w.configuration.userContentController.add(shared, name: "rlock")
    }

    func userContentController(_ userContentController: WKUserContentController, didReceive message: WKScriptMessage) {
        let body = message.body as? [String: Any]
        let op = (body?["op"] as? String) ?? "unlock"
        if op == "unlock" { authenticate() }
    }

    func lock() {
        if skip { unlocked = true; return }
        unlocked = false
        tellWeb(["ok": false, "locked": true])
    }

    func authenticate(reason: String = "Unlock DRAGON SKULL") {
        if skip { unlocked = true; tellWeb(["ok": true, "skipped": true]); return }
        let ctx = LAContext()
        var err: NSError?
        // deviceOwnerAuthentication: Face ID, then device passcode. Never biometrics-only.
        guard ctx.canEvaluatePolicy(.deviceOwnerAuthentication, error: &err) else {
            // No lock enrolled on this device — do not brick the app.
            unlocked = true
            tellWeb(["ok": true, "fallback": "no-device-auth"])
            return
        }
        ctx.evaluatePolicy(.deviceOwnerAuthentication, localizedReason: reason) { ok, e in
            Task { @MainActor in
                self.unlocked = ok
                var r: [String: Any] = ["ok": ok]
                if !ok, let e { r["err"] = e.localizedDescription }
                self.tellWeb(r)
            }
        }
    }

    func notePhase(_ ph: ScenePhase) {
        if skip { return }
        if ph == .background { backgrounded = true; lock() }
        if ph == .active, backgrounded { backgrounded = false; authenticate() }
    }

    private func tellWeb(_ r: [String: Any]) {
        guard let w = webView,
              let data = try? JSONSerialization.data(withJSONObject: r),
              let json = String(data: data, encoding: .utf8) else { return }
        w.evaluateJavaScript("window.RDRAGON_LOCK_RESULT && window.RDRAGON_LOCK_RESULT(\(json));", completionHandler: nil)
    }
}

