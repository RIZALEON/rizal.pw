  setGlobe(v){if(needsGlobe!==!!v){needsGlobe=!!v;render();}},
  setReturnLabel(s){if(typeof s==="string"&&s.length<=12&&s!==returnLabel){returnLabel=s;render();}},
  setContext(s){if(typeof s==="string")setEcho(s);}
 };
 setEcho("");render();post({op:"ready"});
})();
