   [ks.slice(0,9),ks.slice(9,18)].forEach(part=>{const row=document.createElement("div");row.className="row";kb.append(row);part.forEach(([k,v])=>glyphKey(row,v,["a","i","u"].includes(k)?k:k+"a"));});
