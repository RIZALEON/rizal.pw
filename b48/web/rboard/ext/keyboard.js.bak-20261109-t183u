 [["EN","EN"],["BAY","ᜀ"],["MAYA","𝋠"],["SYM","#+"]].forEach(([id,label])=>{const b=document.createElement("button");b.type="button";b.dataset.layer=id;b.textContent=label;b.onclick=()=>{layer=id;shift=caps=false;render();};nav.append(b);});
