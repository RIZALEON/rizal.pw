.grk-toggle{border:1px solid #a8864f;background:#392340;color:#efcf88;border-radius:12px;min-width:48px;min-height:48px;font:24px system-ui;cursor:pointer}.grk-toggle:focus-visible,.grk-close:focus-visible{outline:3px solid #ffd893;outline-offset:3px}.grk-dialog{background:#160e20;color:#f4e9d4;border:1px solid #b18c58;border-radius:20px;padding:0;width:min(1100px,96vw);height:90dvh;max-height:96dvh;overflow:hidden}.grk-dialog::backdrop{background:#08050ccc;backdrop-filter:blur(8px)}.grk-close{display:block;margin:10px 14px 8px auto;border:1px solid #9c7c4b;background:#392340;color:#efcf88;border-radius:10px;padding:10px 18px;min-height:44px;cursor:pointer}.grk-dialog iframe{display:block;width:100%;height:calc(100% - 64px);border:0}
@media(max-width:600px),(max-height:500px){.grk-dialog{width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;border-radius:0;padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}.grk-close{margin:4px max(10px,env(safe-area-inset-right)) 4px auto;min-height:44px;padding:8px 14px}.grk-dialog iframe{height:calc(100% - 56px)}}

.grk-component{height:calc(100% - 64px);overflow:auto;overscroll-behavior:contain}@media(max-width:600px),(max-height:500px){.grk-component{height:calc(100% - 56px)}}
