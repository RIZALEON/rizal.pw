<script>
// Minimal boot host for TinyEMU riscv64 (no jslinux login UI). Parent talks via postMessage.
window.__RVM_LINUX = { out: '', ready: false, booted: false, t0: Date.now() };
var console_write1 = null, net_state = null; // globals TinyEMU's JS glue expects (eth off)
