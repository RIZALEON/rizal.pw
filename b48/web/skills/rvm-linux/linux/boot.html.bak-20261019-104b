    var m, re = /\x1b\]777;rvm-fetch;([^\x07]*)\x07/g;
    while ((m = re.exec(s))) parent.postMessage({t:'rvm.linux.fetch', url: m[1]}, '*');
    s = s.replace(re, ''); var k = s.lastIndexOf('\x1b]777'); if (k >= 0 && s.indexOf('\x07', k) < 0) { oscBuf = s.slice(k); s = s.slice(0, k); }
