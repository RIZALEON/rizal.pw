})(Module);
// == SCOUT cleanstop 2026-10-19 BEGIN ==
// Clean stop for drive1: interrupt the foreground job, then have the guest sync and unmount /data (fallback: remount ro)
// so the ext2 clean flag and free counts reach the disk, wait for the ack marker (or a timeout), THEN flush drive1 writes.
// No root-image change: the commands are typed on hvc0 like a user would. The marker is split in the typed text so the
// echoed command line can't match it. done(how): 'ack' | 'timeout' | 'nodrive'.
window.__RVM_CLEANSTOP = function(L, M, ms, done){
