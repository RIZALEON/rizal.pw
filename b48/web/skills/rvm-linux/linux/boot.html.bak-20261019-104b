  console_write1 = Module.cwrap('console_queue_char', null, ['number']);
  var term = window.term = new Term(80, 30, term_handler, 10000); // TinyEMU console_write/get_size use global term
  var w = term.write.bind(term), wl = term.writeln.bind(term);
  // 0.1.2: guest https bridge. rvmget prints ESC ]777;rvm-fetch;<url> BEL on hvc0; we strip it and ask the parent ЯVM net gate.
  var oscBuf = '';
