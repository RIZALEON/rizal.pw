// == SCOUT rebuild 2026-10-19: drive1 write-back glue (same text as STAGING/tinyemu-rebuild-20261019/test/drive1-writeback.js) ==
// The rebuilt emulator calls Module.onDriveWrite(drive, blk, Uint8Array) once per dirty 256 KB block (debounced ~400 ms).
// Only drive index 1 is sent; drive0 (root) never calls it and the host has no write route for it. Sequential PUTs, retry on network error.
(function(M){
  var q = {}, busy = false;
